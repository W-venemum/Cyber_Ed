# Assessment Auditor - example configuration
#
# Copy this file to `.env` (which is gitignored) and adjust values for your
# local setup. This file contains NO secrets, API keys, or personal data:
# the prototype has no database, no authentication, and no external services.

# ---- Frontend (Vite) ----
# Base URL of the FastAPI backend. Read at build/dev time via
# import.meta.env.VITE_API_BASE_URL. Defaults to http://localhost:8000 when unset.
VITE_API_BASE_URL=http://localhost:8000

# ---- Backend (FastAPI CORS) ----
# Comma-separated list of allowed browser origins for CORS. Defaults to the
# Vite dev server origin when unset.
CORS_ALLOW_ORIGINS=http://localhost:5173
